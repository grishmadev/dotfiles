# define color
set $bg     #2c2c2e
set $fg     #9f9f9f
set $hi     #efef8f
set $ac     #116655
set $tx     #f1f1f1
set $ia     #8f8f8f
set $be     #8faf9f
set $yw     #f8f893
set $gn     #88b090
set $rd     #e89393
set $id     #1c4a1c
set $ce     #ceecee

# set some nice colors      border  background  text    indicator  child_border
client.focused              $id     $ac         $tx     $id        $tx
client.unfocused            $bg     $bg         $ia     $id
client.focused_inactive     $bg     $bg         $ac     $id
client.urgent               $yw     $yw         $tx     $id

# --- Input (replaces xset r rate / xinput-fix / setxkbmap) -----------
input type:keyboard {
    # same as: xset r rate 200 100
    repeat_delay 200
    repeat_rate 100
    # xkb_layout us
    # same as: setxkbmap -option ctrl:nocaps
    # xkb_options ctrl:nocaps
}

# I don't know what your xinput-fix script did, so these are common touchpad defaults. Edit to taste.
input type:touchpad {
    tap enabled
    dwt enabled
}

# --- Start applications ----------------------------------------------
# exec nm-applet --indicator

# conky draws on X11 by default. Newer conky can do Wayland if its config has: out_to_wayland = true
# exec conky -d -c ~/.config/sway/conky-right
# exec conky -d -c ~/.config/sway/conky-left
# exec conky -d -c ~/.config/sway/conky-bottom

# old ~/.i3/bin/bar script (waybar replaces it)
# exec ~/.config/sway/bin/bar

exec dunst

# input method (needs GTK_IM_MODULE=ibus, QT_IM_MODULE=ibus, XMODIFIERS=@im=ibus in your environment)
exec ibus-daemon --xim -d -r
# Vietnamese "Unikey" engine from the original config. Delete this line if you don't use it.
exec dconf write /desktop/ibus/general/engines-order "['xkb:us::eng', 'Unikey']"

# auto lock after 5 minutes (swayidle replaces xautolock)
exec swayidle -w timeout 300 'swaylock -f -c 000000'

# screen warmth + gamma (gammastep replaces redshift and "xrandr --gamma")
# gammastep needs your location: put lat/lon in ~/.config/gammastep/config.ini or add -l LAT:LON
exec gammastep -g 0.7

# clipboard manager (cliphist replaces clipmenud)
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
bindsym $mod+Insert exec cliphist list | rofi -dmenu | cliphist decode | wl-copy

# lock screen
bindsym --release XF86ScreenSaver exec $lock
bindsym --release $mod+Delete exec $lock
bindsym --release $mod+Mod1+l exec $lock
bindsym --release control+Mod1+Delete exec $lock

# Audio controls (amixer works on ALSA/PulseAudio)
# If it does not change volume on PipeWire, use these instead:
#   wpctl set-volume @DEFAULT_AUDIO_SINK@ 3%+
#   wpctl set-volume @DEFAULT_AUDIO_SINK@ 3%-
#   wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioRaiseVolume exec amixer -q sset Master 3%+
bindsym XF86AudioLowerVolume exec amixer -q sset Master 3%-
bindsym XF86AudioMute exec amixer -q sset Master toggle

# Audio Playback
bindsym $mod+space exec playerctl play-pause
bindsym $mod+Mod1+Ctrl+l exec playerctl next
bindsym $mod+Mod1+Ctrl+h exec playerctl previous
bindsym $mod+Mod1+Ctrl+Right exec playerctl position 5+
bindsym $mod+Mod1+Ctrl+Left exec playerctl position 5-

# sudo apt install brightnessctl
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Touchpad controls
bindsym --release XF86Sleep exec $lock && systemctl suspend

# Screenshot (grim + slurp replace scrot / gnome-screenshot)
# Print: whole screen, saved to /tmp
bindsym Print exec grim /tmp/screenshot-$(date +%s).png
# $mod+Print: drag to select an area, goes to the clipboard
bindsym $mod+Print exec grim -g "$(slurp)" - | wl-copy

# Toggle fastly terminal
# NOTE: "fn" is a script that probably uses i3-msg/xdotool. It needs porting too.
bindsym $mod+Escape exec ~/.config/sway/bin/fn esc
# keycode 49 = grave (the ` key)
bindcode $mod+49 exec ~/.config/sway/bin/fn 0
bindsym $mod+F12 exec ~/.config/sway/bin/fn 12

# More workspaces
bindsym $mod+F1 workspace number 11 F1
bindsym $mod+F2 workspace number 12 F2
bindsym $mod+F3 workspace number 13 F3
bindsym $mod+F4 workspace number 14 F4
bindsym $mod+F5 workspace number 15 F5
bindsym $mod+F6 workspace number 16 F6
bindsym $mod+F7 workspace number 17 F7
bindsym $mod+F8 workspace number 18 F8
bindsym $mod+F9 workspace number 19 F9
bindsym $mod+F10 workspace number 20 F10
bindsym $mod+F11 workspace number 21 F11

# Media player controls
bindsym XF86AudioPlay exec mpc toggle
bindsym XF86AudioPause exec mpc pause
bindsym XF86AudioNext exec mpc next
bindsym XF86AudioPrev exec mpc prev

# screen off (replaces xset dpms force off; use "dpms off" on sway older than 1.8)
bindsym XF86Launch1 exec swaymsg "output * power off"

# Assign workspace
# Wayland apps use app_id, XWayland apps use class. Both are listed to be safe.
# Verify with: swaymsg -t get_tree | grep -E 'app_id|class'
assign [app_id="org.keepassxc.KeePassXC"] workspace $tag0
assign [class="keepassxc"] workspace $tag0

## shortcut
# neovim (needs a terminal, plain "nvim" has nowhere to draw)
bindsym $mod+Mod1+i exec kitty nvim
# keepassx
bindsym $mod+Mod1+k exec keepassxc
# email
bindsym $mod+Mod1+e exec thunderbird
# browser
bindsym $mod+Mod1+n exec nyxt
bindsym $mod+Mod1+b exec firefox -P default
bindsym $mod+Mod1+Shift+b exec firefox -P default --private-window
bindsym $mod+Mod1+g exec chromium --temp-profile
bindsym $mod+Mod1+Shift+g exec chromium --temp-profile --incognito
# gimp
bindsym $mod+Mod1+p exec gimp
# network (wicd is dead and X11-only; nmtui is a simple NetworkManager TUI. Swap for what you use.)
bindsym $mod+Mod1+w exec kitty nmtui
# explore (rxvt is X11; ranger inside kitty instead)
bindsym $mod+Mod1+r exec kitty ranger
# youtube scratchpad (keycode 90 = numpad 0)
bindcode $mod+90 [title="YouTube"] scratchpad show
for_window [title="YouTube"] sticky enable

exec swaymsg workspace number 1 $tag1
# nitrogen/picom are X11 only. sway draws the wallpaper itself:
output * bg ~/Pictures/wallpapers/racecar.png fill

# "xset b off" (terminal bell) is not needed, Wayland has no X bell.
